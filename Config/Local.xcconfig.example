// Your Personal Team id (Xcode > Settings > Accounts > Apple ID > Manage Certificates, or the
// OU field of your "Apple Development" certificate). A free Apple ID works.
DEVELOPMENT_TEAM = XXXXXXXXXX
// Bundle ids are claimed per team; pick one that is free for your account.
LILY_BUNDLE_ID = dev.lily.browser.ios.yourname // the Share extension becomes <id>.share
